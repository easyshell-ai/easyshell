# ============================================================
# EasyShell Docker Compose Configuration — ALL OPTIONAL
#
#   docker compose up -d
#
# Nothing in this file is required. On first boot a one-shot container
# (scripts/init-secrets.sh) generates the database password, JWT secret,
# encryption key and agent registration secret into the "easyshell_secrets"
# volume, and every later start reuses them.
#
# Copy this file to .env only when you want to pin a specific value:
#   cp .env.example .env
# ============================================================

# --- Ports (host side) ---
MYSQL_PORT=13306        # bound to 127.0.0.1 only
REDIS_PORT=16379        # bound to 127.0.0.1 only
SERVER_PORT=18080
WEB_PORT=18880

# --- Database name ---
MYSQL_DATABASE=easyshell

# --- JVM ---
JAVA_OPTS=-Xms256m -Xmx512m

# --- Server URL handed to agents during one-click deployment ---
# Agents on other machines must be able to reach this address.
# PROVISION_SERVER_URL=http://your-server-ip:18080

# ============================================================
# Secrets — leave them out and they are generated for you.
# Set a value here only to pin it; the first boot writes it into the
# secrets volume and later starts keep using it.
# ============================================================
# MYSQL_PASSWORD=
# JWT_SECRET=                 # at least 32 bytes
# ENCRYPTION_KEY=             # at least 16 characters
# AGENT_REGISTER_SECRET=      # shared secret for agent registration

# --- Initial admin account (first startup only) ---
# Leave unset to have the server generate a random initial password;
# it is printed once in the server logs on first start.
# EASYSHELL_ADMIN_PASSWORD=

# --- Docker Images ---
# Default: Docker Hub. Uncomment to use GHCR instead.
# EASYSHELL_SERVER_IMAGE=ghcr.io/easyshell-ai/easyshell/easyshell-server:latest
# EASYSHELL_WEB_IMAGE=ghcr.io/easyshell-ai/easyshell/easyshell-web:latest
