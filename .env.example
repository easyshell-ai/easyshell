# ============================================================
# EasyShell Docker Compose Configuration
# Copy this file to .env and modify as needed:
#   cp .env.example .env
# ============================================================

# --- MySQL ---
# REQUIRED: set a strong password. Compose will refuse to start without it.
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_DATABASE=easyshell
MYSQL_PORT=13306

# --- Redis ---
REDIS_PORT=16379

# --- Server ---
SERVER_PORT=18080
JAVA_OPTS=-Xms256m -Xmx512m

# Provision URL: the externally-reachable URL of the server.
# Agents use this URL to connect. Change to your server's public IP/domain.
# PROVISION_SERVER_URL=http://your-server-ip:18080

# --- Web ---
WEB_PORT=18880

# --- Security (REQUIRED: generate random values, never reuse the examples) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=generate-a-random-secret-of-at-least-64-characters
# Generate with: openssl rand -base64 24
ENCRYPTION_KEY=generate-a-random-aes256-key

# --- Initial admin account (first startup only) ---
# Leave empty to have the server generate a random initial password
# (it is printed once in the server logs on first start).
# EASYSHELL_ADMIN_PASSWORD=

# --- Docker Images ---
# Default: Docker Hub. Uncomment to use GHCR instead.
# EASYSHELL_SERVER_IMAGE=ghcr.io/easyshell-ai/easyshell/easyshell-server:latest
# EASYSHELL_WEB_IMAGE=ghcr.io/easyshell-ai/easyshell/easyshell-web:latest

# --- Agent registration ---
# Shared secret a newly installed agent presents once (header X-Agent-Register-Secret)
# to obtain its own long-lived token. Required for agents to register.
# Generate with: openssl rand -base64 32
AGENT_REGISTER_SECRET=generate-a-random-secret-of-at-least-32-characters
